# Copy to .env. Values below point at the mock (python -m adfs_auth.mock_adfs serve).
# For real ADFS: run adfs-auth-probe and paste the block it prints instead.
ADFS_AUTH_AUDIENCE=urn:example:inventory-api
ADFS_AUTH_ISSUERS=http://localhost:9000/adfs/services/trust
ADFS_AUTH_JWKS_URL=http://localhost:9000/adfs/discovery/keys
ADFS_AUTH_POLICY_FILE=policy.json
# ADFS_AUTH_CA_BUNDLE=C:/certs/corp-root.pem
