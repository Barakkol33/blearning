---
// Page title, with an "under construction" badge for pages inside a `status: stub` subject or course.
import { getCollection } from 'astro:content';

const { entry } = Astro.locals.starlightRoute;
const stubs = (await getCollection('docs', (e) => e.data.status === 'stub')).map((e) => e.id);
const stub = stubs.some((id) => entry.id === id || entry.id.startsWith(`${id}/`));
---

<h1 id="_top">
	{entry.data.title}
	{stub && <span class="bl-stub" title="התוכן כאן עדיין בסיסי מאוד ולא גמור">🚧 בבנייה</span>}
</h1>

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bl-stub {
		display: inline-block;
		vertical-align: middle;
		margin-inline-start: 0.6rem;
		padding: 0.15rem 0.7rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		border: 1px solid var(--sl-color-orange);
	}
</style>
