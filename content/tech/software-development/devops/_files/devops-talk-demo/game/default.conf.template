# The game's web server. nginx fills in ${...} from environment variables when it starts.
server {
  listen 80;
  keepalive_timeout 0;   # a new connection per request, so every request can hit a different copy
  root /usr/share/nginx/html;

  # which version, color, copy and machine answered - read by the page and by ./demo.sh watch
  location = /plain {
    default_type text/plain;
    return 200 "${VERSION} ${COLOR} ${POD_NAME} ${NODE_NAME}\n";
  }

  # Kubernetes asks this every second: "are you ready for players?"
  location = /healthz {
    return 200 "ok\n";
  }

  # the game itself; any other address is "404 not found"
  location / {
    try_files $uri $uri/ =404;
  }
}
